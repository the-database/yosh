<?xml version="1.0" encoding="utf-8"?>
<!-- Pure-NativeActivity app: no Java/Dex (hasCode=false). The framework
     NativeActivity loads libyosh_android.so via the lib_name meta-data, which
     calls android-activity's ANativeActivity_onCreate -> our android_main. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.thedatabase.yosh">

    <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />

    <!-- Browse a comic library folder directly (like Perfect Viewer / the desktop).
         A "special" permission the user grants once in Settings; fine for a
         sideloaded personal app. Android 11+ only. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <!-- Android 10 and below have no MANAGE_EXTERNAL_STORAGE: use the legacy
         storage model + runtime READ instead (paired with requestLegacyExternalStorage
         below). maxSdkVersion=29 so 11+ devices keep using MANAGE only. -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29" />

    <application
        android:label="yosh"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:extractNativeLibs="true"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name="com.thedatabase.yosh.YoshActivity"
            android:exported="true"
            android:configChanges="orientation|keyboardHidden|screenSize|screenLayout|density|uiMode">
            <meta-data
                android:name="android.app.lib_name"
                android:value="yosh_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
